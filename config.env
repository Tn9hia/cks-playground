#!/usr/bin/env bash
# Shared settings for all scripts. Source this file, don't execute it.

export VM_IMAGE="24.04"          # Ubuntu LTS image multipass will fetch
export MASTER_NAME="k8s-master"
export WORKER_NAME="k8s-worker"

export CPUS="2"                  # kubeadm requires >= 2 CPUs on the control-plane node
export MEM="2G"
export DISK="10G"

# Kubernetes minor version for kubeadm/kubelet/kubectl (pkgs.k8s.io repo, format vX.Y).
# Only read when the VMs are created: destroy and re-run 01 after changing it.
export K8S_VERSION="v1.36"

# Must NOT overlap the multipass VM network (192.168.252.0/24 on macOS) or any LAN
# you route to: Calico's default 192.168.0.0/16 did, and its blackhole/tunl0 routes
# for a 192.168.252.x pod block cut the nodes off from the host.
export POD_CIDR="10.244.0.0/16"
export CALICO_MANIFEST="https://raw.githubusercontent.com/projectcalico/calico/v3.28.0/manifests/calico.yaml"

# Used by 02-init-master-cilium.sh instead of Calico.
export CILIUM_VERSION="1.20.2"
export CILIUM_CLI_VERSION="v0.20.1"

# Returns the first IPv4 address of a multipass instance.
get_ip() {
  multipass info "$1" --format json | jq -r ".info[\"$1\"].ipv4[0]"
}
